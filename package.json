{
  "name": "effect-form",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vp build",
    "dev": "vp dev",
    "fmt": "vp fmt --ignore-path=.oxfmtignore",
    "lint": "vp lint",
    "lint:github": "vp lint --format=github",
    "prepare": "vp config && effect-tsgo patch --oxlint",
    "preview": "vp preview",
    "test": "vp test --project node",
    "test:browser": "vp test --project browser",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@effect/ai-anthropic": "4.0.0-rc.112",
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "4.0.0-rc.112",
    "lucide-react": "^1.43.0",
    "nuqs": "^2.10.1",
    "posthog-js": "^1.428.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.44.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-react-remove-properties": "^0.3.1",
    "playwright": "*",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
